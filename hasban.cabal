name:                hasban
version:             0.1.0.0
homepage:            https://github.com/ltouro/hasban#readme
license:             BSD3
license-file:        LICENSE
author:              Lucas
maintainer:          lucas@uy3.com.br
copyright:           2022 Lucas T C
category:            Finance
build-type:          Simple
cabal-version:       >=1.10
extra-source-files:  README.md

library
  hs-source-dirs:      src
  exposed-modules:     
    HelloApi      
    LoanApi                
    UserApi
    LoanCalculator
    -- Elastic
  other-modules:
  build-depends:       base >= 4.7 && < 5
                      , servant
                      , servant-server
                      , text                     
                      , aeson                      
                      , bytestring
                      , time
                      , boxes                          
                      , bloodhound
                      , http-client
                      , http-client-tls
                      , pretty-show
                      , semigroups
                      , vector
                      , persistent
                      , persistent-template
                      , persistent-sqlite
                      , string-conversions
                      , transformers
                      , monad-logger
                      , resourcet
  default-language:    Haskell2010
  ghc-options: -Wall

executable hasban
  hs-source-dirs:      app
  main-is:             Main.hs
  default-language:    Haskell2010
  build-depends:       base >= 4.7 && < 5
                      , servant
                      , servant-server
                      , servant-swagger
                      , swagger2
                      , text
                      , wai
                      , wai-logger
                      , aeson
                      , warp
                      , bytestring
                      , mtl
                      , transformers
                      , hasban
                      , bloodhound
                      , http-client
                      , http-client-tls
                      , pretty-show
                      , semigroups
                      , vector
                      , persistent
                      , persistent-template
                      , persistent-sqlite
                      , string-conversions
                      , monad-logger
                      , resourcet
  ghc-options:         -threaded -rtsopts -with-rtsopts=-N
