name:                hasban
version:             0.1.0.0
homepage:            https://github.com/ltouro/hasban#readme
license:             BSD3
license-file:        LICENSE
author:              Lucas
maintainer:          lucas@uy3.com.br
copyright:           2022 Lucas T C
category:            Finance
build-type:          Simple
cabal-version:       >=1.10
extra-source-files:  README.md

library
  ghc-options: -Wall
  hs-source-dirs:      src
  exposed-modules:     LoanCalculator                       
  build-depends:       base >= 4.7 && < 5
                       , servant
                       , servant-server
                       , servant-swagger
                       , swagger2
                       , text
                       , wai
                       , aeson
                       , warp
                       , bytestring
                       , mtl
                       , transformers
  default-language:    Haskell2010

executable hasban
  hs-source-dirs:      app
  main-is:             Main.hs
  default-language:    Haskell2010
  build-depends:       base, time, boxes, servant
  ghc-options:         -threaded -rtsopts -with-rtsopts=-N
